{
  "name": "inventario-multialmacen-dyno",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de Gestión de Inventario Multialmacén - Distribuciones Dyno S.C.R.L.",
  "scripts": {
    "dev": "node --experimental-websocket --experimental-require-module ./node_modules/astro/bin/astro.mjs dev --port 3000",
    "build": "node --experimental-websocket --experimental-require-module ./node_modules/astro/bin/astro.mjs build",
    "preview": "node --experimental-websocket --experimental-require-module ./node_modules/astro/bin/astro.mjs preview",
    "typecheck": "node --experimental-websocket --experimental-require-module ./node_modules/astro/bin/astro.mjs check",
    "lint": "eslint src db",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@nanostores/react": "^2.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "nanostores": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.13",
    "tailwindcss": "^4.3.3",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "typescript": "5.8",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
